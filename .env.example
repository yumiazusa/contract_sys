FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5600
SECRET_KEY=replace-with-a-long-random-string

# 数据库连接
DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/projectdb

# 低配服务器连接池建议
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Linux 生产启动建议
GUNICORN_BIND=0.0.0.0:5600
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_MAX_REQUESTS=300
GUNICORN_MAX_REQUESTS_JITTER=30
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
